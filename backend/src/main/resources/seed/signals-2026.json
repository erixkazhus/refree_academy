ory":"Number of Players","name":"No. 1 – 5","action":"Right hand shows number 1 to 5","imagePath":"/signals/signal-28.png"},{"number":29,"category":"Number of Players","name":"No. 6 – 10","action":"Right hand shows number 5, left hand shows number 1 to 5","imagePath":"/signals/signal-29.png"},{"number":30,"category":"Number of Players","name":"No. 11 – 15","action":"Right hand shows clenched fist, left hand shows number 1 to 5","imagePath":"/signals/signal-30.png"},{"number":31,"category":"Number of Players","name":"No. 16","action":"First reverse hand shows 1 for decade digit — then open hands show 6 for units’ digit","imagePath":"/signals/signal-31.png"},{"number":32,"category":"Number of Players","name":"No. 24","action":"First reverse hand shows 2 for decade digit — then open hand shows 4 for units’ digit","imagePath":"/signals/signal-32.png"},{"number":33,"category":"Number of Players","name":"No. 40","action":"First reverse hand shows 4 for decade digit — then open hand shows 0 for units’ digit","imagePath":"/signals/signal-33.png"},{"number":34,"category":"Number of Players","name":"No. 62","action":"First reverse hands show 6 for decade digit — then open hand shows 2 for units’ digit","imagePath":"/signals/signal-34.png"},{"number":35,"category":"Number of Players","name":"No. 78","action":"First reverse hands show 7 for decade digit — then open hands show 8 for units’ digit","imagePath":"/signals/signal-35.png"},{"number":36,"category":"Number of Players","name":"No. 99","action":"First reverse hands show 9 for decade digit — then open hands show 9 for units’ digit","imagePath":"/signals/signal-36.png"},{"number":37,"category":"Type of Fouls","name":"HOLDING","action":"Grasp wrist downward","imagePath":"/signals/signal-37.png"},{"number":38,"category":"Type of Fouls","name":"BLOCKING (DEFENSE), ILLEGAL SCREEN (OFFENSE)","action":"Both hands on hips","imagePath":"/signals/signal-38.png"},{"number":39,"category":"Type of Fouls","name":"PUSHING OR CHARGING WIT