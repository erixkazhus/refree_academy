.png"},{"number":52,"category":"Special Fouls / Warnings","name":"DOUBLE FOUL","action":"Wave clenched fists on both hands","imagePath":"/signals/signal-52.png"},{"number":53,"category":"Special Fouls / Warnings","name":"TECHNICAL FOUL","action":"Form T, showing palms","imagePath":"/signals/signal-53.png"},{"number":54,"category":"Special Fouls / Warnings","name":"DISRUPTIVE FOUL","action":"One arm with clenched fist, followed by showing 2 at face level","imagePath":"/signals/signal-54.png"},{"number":55,"category":"Special Fouls / Warnings","name":"FLAGRANT FOUL","action":"Grasp wrist upward","imagePath":"/signals/signal-55.png"},{"number":56,"category":"Special Fouls / Warnings","name":"DISQUALIFYING FOUL","action":"Clenched fists on both hands","imagePath":"/signals/signal-56.png"},{"number":57,"category":"Special Fouls / Warnings","name":"FAKE A FOUL","action":"Lower the forearm twice","imagePath":"/signals/signal-57.png"},{"number":58,"category":"Special Fouls / Warnings","name":"DELAY OF GAME","action":"Wave forearm horizontally twice","imagePath":"/signals/signal-58.png"},{"number":59,"category":"Special Fouls / Warnings","name":"ILLEGAL BOUNDARY LINE CROSSING ON A THROW-IN","action":"Wave arm parallel to boundary line (last 2 minutes of Q4 and OT)","imagePath":"/signals/signal-59.png"},{"number":60,"category":"Instant Replay System","name":"IRS REVIEW","action":"Rotate hand with horizontal extended index finger","imagePath":"/signals/signal-60.png"},{"number":61,"category":"Instant Replay System","name":"HEAD COACH’S CHALLENGE","action":"Referee confirms head coach’s challenge request","imagePath":"/signals/signal-61.png"},{"number":62,"category":"Reporting to Table","name":"AFTER FOUL WITHOUT FREE THROW(S)","action":"Point in direction of play, arm parallel to sidelines","imagePath":"/signals/signal-62.png"},{"number":63,"category":"Reporting to Table","name":"AFTER FOUL BY TEAM IN CONTROL OF THE BALL","action":"Clenched fist in direction of play, arm paral