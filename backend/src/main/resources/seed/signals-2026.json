[{"number":1,"category":"Game clock signals","name":"STOP THE CLOCK","action":"Open palm","imagePath":"/signals/signal-01.png"},{"number":2,"category":"Game clock signals","name":"STOP THE CLOCK FOR FOUL","action":"One clenched fist","imagePath":"/signals/signal-02.png"},{"number":3,"category":"Game clock signals","name":"START THE CLOCK","action":"Chop with hand","imagePath":"/signals/signal-03.png"},{"number":4,"category":"Scoring","name":"1 POINT","action":"1 finger, ‘flag’ from wrist","imagePath":"/signals/signal-04.png"},{"number":5,"category":"Scoring","name":"2 POINTS","action":"2 fingers, ‘flag’ from wrist","imagePath":"/signals/signal-05.png"},{"number":6,"category":"Scoring","name":"3 POINTS","action":"3 fingers extended · One arm: Attempt / Both arms: Successful","imagePath":"/signals/signal-06.png"},{"number":7,"category":"Substitution and Time-out","name":"SUBSTITUTION","action":"Cross forearms","imagePath":"/signals/signal-07.png"},{"number":8,"category":"Substitution and Time-out","name":"BECKONING-IN","action":"Open palm, wave towards the body","imagePath":"/signals/signal-08.png"},{"number":9,"category":"Substitution and Time-out","name":"CHARGED TIME-OUT","action":"Form T, show index finger","imagePath":"/signals/signal-09.png"},{"number":10,"category":"Substitution and Time-out","name":"MEDIA TIME-OUT","action":"Open arms with clenched fists","imagePath":"/signals/signal-10.png"},{"number":11,"category":"Informative","name":"CANCEL SCORE, CANCEL PLAY","action":"Scissor-like action with arms, once across chest","imagePath":"/signals/signal-11.png"},{"number":12,"category":"Informative","name":"VISIBLE COUNT","action":"Counting while moving the palm","imagePath":"/signals/signal-12.png"},{"number":13,"category":"Informative","name":"COMMUNICATION","action":"Thumb up","imagePath":"/signals/signal-13.png"},{"number":14,"category":"Informative","name":"SHOT CLOCK RESET","action":"Rotate hand, extend index finger","imagePath":"/signals/signal-14.png"},{